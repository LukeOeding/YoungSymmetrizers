    ta:=L#0; tb:=L#1;tc:=L#2;td:=L#3;te:=L#4;
    dg := length flatten ta;
    --R := X[a_(0,0)..a_(1,dg-1),b_(0,0)..b_(1,dg-1),c_(0,0)..c_(1,dg-1),d_(0,0)..d_(1,dg-1),e_(0,0)..e_(1,dg-1),f_(0,0)..f_(1,dg-1), ];
    A := apply(ta, L -> list2mats(L, a)); B := apply(tb, L -> list2mats(L, b));
    C := apply(tc, L -> list2mats(L, c)); D := apply(td, L -> list2mats(L, d));
    E := apply(te, L -> list2mats(L, e));
    usedA := {};usedB := {};usedC := {};usedD := {}; usedE := {};
    Fp :=1; T :=1;
    for z to dg-1 do (
        T=product(
            (for i to sub(dg/2-1,ZZ) list if isMember(z + 1,ta#i) and not isMember(i,usedA) then (usedA = usedA|{i}; det2 A_i) else continue)|
            (for i to sub(dg/2-1,ZZ) list if isMember(z + 1,tb#i) and not isMember(i,usedB) then (usedB = usedB|{i}; det2 B_i) else continue)|
            (for i to sub(dg/2-1,ZZ) list if isMember(z + 1,tc#i) and not isMember(i,usedC) then (usedC = usedC|{i}; det2 C_i) else continue)|
            (for i to sub(dg/2-1,ZZ) list if isMember(z + 1,td#i) and not isMember(i,usedD) then (usedD = usedD|{i}; det2 D_i) else continue)|
            (for i to sub(dg/2-1,ZZ) list if isMember(z + 1,te#i) and not isMember(i,usedE) then (usedE = usedE|{i}; det2 E_i) else continue)
        );
    Fp = Fp*T; -- you could insert a time before this...
 Fp= sum(2,m-> sum(2, l-> sum(2,k-> sum(2, j-> sum(2, i-> 
    x_(i,j,k,l,m)*compress(diff(a_(i,z), compress diff(b_(j,z), compress diff(c_(k,z),compress diff(d_(l,z),compress diff(e_(m,z),Fp)))))))))));
 ); -- after many checks (parallel sum, making auxillary arrays, using diff over a tensor, etc), this seems to be the most efficient way to execute the sum.
 Fp
);

time inv4 = tab2poly({syt4#0,syt4#0,syt4#0,syt4#0,syt4#1}); -- 2.32s for SLPExpressions
elapsedTime inv6 = tab2poly({syt6#0, syt6#1, syt6#2, syt6#3, syt6#4}); 
-- 1.09s (tensor product ring) vs .934s (flat ring), 11.61s for SLPExpressions
elapsedTime inv8 = tab2poly({syt8#0,syt8#0,syt8#1,syt8#2,syt8#7}); -- this is the first independent invariant we find
-- 10s for polynomials
-- 20s for SLPexpressions
elapsedTime inv10b = tab2poly({syt10#0,syt10#17,syt10#24,syt10#37,syt10#40}); 
-- approx 448s for polynomials
 -- 1182.31s elapsed for SLPExpressions

