-- using SLPexpressions to evaluate Young symmetrizers
restart
loadPackage"SLPexpressions"
for i5 to 1 do for i4 to 1 do for i3 to 1 do for i2 to 1 do for i1 to 1 do declareVariable x_(i1,i2,i3,i4,i5)
for j to 1 do for dg to 16 do declareVariable a_(j,dg)
f = det matrix apply(2, i -> apply(2, j-> a_(i,j)))

det2 = method()
det2 GateMatrix := M -> (
    m := numrows M;
    n := numcols M;
    assert(m == 2 and n == 2);
    M_(0,0) * M_(1,1) - M_(1,0) * M_(0,1)
    )
f = det2 matrix apply(2, i -> apply(2, j-> a_(i,j)))
compress diff(a_(0,0),f)

for j to 1 do for dg to 16 do declareVariable b_(j,dg)
for j to 1 do for dg to 16 do declareVariable c_(j,dg)
for j to 1 do for dg to 16 do declareVariable d_(j,dg)
for j to 1 do for dg to 16 do declareVariable e_(j,dg)

