--syt4 = {{{1,2},{3,4}},{{1,3},{2,4}}}
time inv4 = tab2poly({syt4#0,syt4#0,syt4#0,syt4#0,syt4#1});
time inv4p = tab2polyPar({syt4#0,syt4#0,syt4#0,syt4#0,syt4#1});
