makeColYS = P-> matrix apply(pts,pt-> {tab2polyMapPar(apply(5, i-> syt12#(P#i)), pt)})
makeColYSPerm = (P,myPerm)-> matrix apply(pts,pt-> {tab2polyMapPar(apply(5, i-> syt12#(P#i)), pt*myPerm)})
makeColYSPar = P-> matrix parallelApply(pts,pt-> {tab2polyMap(apply(5, i-> syt12#(P#i)), pt)})


    pts= apply(228, i-> rndPt());
    makeMgProd = myPerm -> sub(matrix parallelApply(pts,pt-> apply(F12nonMGprod, pf-> value(product(toList pf, f-> (pt*myPerm) f)))), baseRing X) ; 
    print("computing the representation matrices");
--Mgs0 = {C141M|transpose C87M}; -- this happened before adding the transpose for C87M.
    Mgs = for rep in reps_{1..6} list (
        elapsedTime C141M = makeMgProd(perm rep);  
        print("made C141M for "|(toString rep) );
        C87M = transpose matrix for mg in mg12 list elapsedTime flatten entries makeColYSPerm(mg, perm rep);
        print("made C87M for "|(toString rep) ); 
        C141M|C87M
    );
Mgs = Mgs0|Mgs;
M = last Mgs; 
myChar12 =   apply(Mgs, MMg->trace(M^(-1)*MMg ))
-- seems to take about 25s per matrix
decomposeCharacter myChar12

