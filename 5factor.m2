tgt = mg8_{0..19} -- just grab the known contributors to the mingens for this filling
ct = 0; myPerms = flatten for i to #tgt-1 list if ct == i then for xx in permutations({0,1,2,3,4}) list if ct == i and P_xx == tgt#i then (ct = ct+1; xx ) else continue
elapsedTime F8big = unique apply(myPerms, p-> (perm p) inv8); -- time if 1.2s if you only use the good permutations,  4s if you use the 60 permutations of 0,0,2,9,12
tmpP = last mg8; elapsedTime inv8b = tab2polyPar(apply(5, i-> syt8#(tmpP#i)));
F8 = F8big|{inv8b};

F44 = flatten apply(5, i-> apply(5-i, j-> F4#i*F4#(i+j)));
time char44 = computeChar(F44)
dchar44 = decomposeCharacter(char44)

F44prod = flatten apply(5, i-> apply(5-i, j-> Product(F4#i,F4#(i+j))));
time char44prod = computeCharProd(F44prod)
dchar44prod = decomposeCharacter(char44prod)

time F444prod = flatten flatten flatten apply(5, i-> apply(5-i, j->  apply(5-i-j, k-> Product((F4#i),F4#(i+j),F4#(i+j+k)))));
-- this is very quick, and doesn't take up nearly as much memory or time as taking the products and expanding them.
charProd444 = computeCharProd(F444prod)
-- seems to take about 5s per matrix
decomposeCharacter charProd444


time F66prod = {Product(inv6,inv6)};
charProd66 = computeCharProd(F66prod)
decomposeCharacter charProd66

F4m8prod = flatten apply(F4, f4-> apply(F8, f8->  Product(f4,f8)));
-- takes about 241s per matrix?
